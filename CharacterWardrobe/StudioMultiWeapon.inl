// Isolated experiment: use the game's independent weapon displays and sockets.
namespace StudioMultiWeapon {
struct Slot {std::string id,skin; ATslWeaponDisplay* display=nullptr; ALobbyCharacter* owner=nullptr; USkeletalMeshComponent* ownerMesh=nullptr; int objectIndex=-1; bool requested=false,issued=false,attached=false; ULONGLONG start=0;};
static Slot slots[3]; static std::unordered_map<std::string,std::string> groups; static bool initialized=false; static int uuid=921000;
static int Role(const std::string& name){auto s=StudioWeaponPreview::Lower(name);if(s=="item_weapon_pan")return 2;if(s=="item_weapon_m9"||s=="item_weapon_m1911"||s=="item_weapon_g18"||s=="item_weapon_nagantm1895"||s=="item_weapon_rhino"||s=="item_weapon_vz61skorpion"||s=="item_weapon_sawnoff")return 1;if(s=="item_weapon_kar98k"||s=="item_weapon_awm"||s=="item_weapon_m24"||s=="item_weapon_win1894"||s=="item_weapon_mini14"||s=="item_weapon_mk14"||s=="item_weapon_sks"||s=="item_weapon_qbu88"||s=="item_weapon_vss")return 0;return -1;}
static void Init(){if(initialized)return;initialized=true;std::ifstream f("studio-weapon-groups.tsv");std::string l;while(std::getline(f,l)){auto p=l.find('\t');if(p!=std::string::npos){auto b=l.substr(p+1);if(!b.empty()&&b.back()=='\r')b.pop_back();groups[l.substr(0,p)]=b;}}out<<"MULTI GROUPS "<<groups.size()<<std::endl;}
static void Clear(Slot& s){auto* objects=UObject::GObjects.GetTypedPtr();if(s.display&&objects&&s.objectIndex>=0&&s.objectIndex<objects->Num()&&objects->GetByIndex(s.objectIndex)==s.display&&!s.display->bActorIsBeingDestroyed){s.display->DespawnWeapon();s.display->K2_DestroyActor();}s=Slot{};}
static void Tick(UWorld* world,AHUD* raw,APlayerController* pc,ULONGLONG now){if(!world||!raw||!raw->IsA(ALobbyHUD::StaticClass())||!pc)return;Init();auto* c=StudioPresentation::placement.actor;int ci=StudioPresentation::placement.index;std::ifstream modeFile("studio-preview-category.txt");std::string mode;std::getline(modeFile,mode);bool available=StudioPresentation::ValidCharacter(c,ci)&&c->Mesh&&StudioCharacterVisibility::Visible()&&mode=="weapon"&&!std::filesystem::exists(L"studio-save.request")&&!std::filesystem::exists(L"studio-preset.request");std::string wanted[3];if(available){std::ifstream f("studio-selection.txt");std::string all,id;std::getline(f,all);std::istringstream is(all);while(std::getline(is,id,',')){auto it=groups.find(id);if(it!=groups.end()){int role=Role(it->second);if(role>=0)wanted[role]=id;}}}
 if(!wanted[2].empty() && StudioWeaponPreview::shown && wanted[2]==StudioWeaponPreview::desired) wanted[2].clear();
 auto* hud=static_cast<ALobbyHUD*>(raw);for(int i=0;i<3;i++){auto& s=slots[i];if(s.display&&(!available||s.owner!=c||!c||s.ownerMesh!=c->Mesh))Clear(s);if(s.id!=wanted[i]){Clear(s);s.id=wanted[i];s.start=now;}if(s.id.empty())continue;auto asset=StudioWeaponPreview::assets.find(s.id);if(asset==StudioWeaponPreview::assets.end())continue;if(!s.requested){TSoftClassPtr<UClass> ref{};auto path=Wide(asset->second);ref.ObjectID.AssetLongPathname=FString(path.c_str());FLatentActionInfo latent{};latent.UUID=uuid++;latent.Linkage=-1;latent.CallbackTarget=world;UKismetSystemLibrary::LoadAssetClass(world,ref,{},latent);s.requested=true;out<<"MULTI LOAD "<<i<<" "<<s.id<<std::endl;continue;}if(!s.issued){auto* cls=StudioWeaponPreview::FindSkinClass(s.id);if(!cls||!cls->DefaultObject||!cls->DefaultObject->IsA(USkinItem::StaticClass())||!hud->LobbyWeaponDisplay)continue;s.skin=static_cast<USkinItem*>(cls->DefaultObject)->SkinParam.SkinName.ToString();auto base=groups[s.id];FTransform t{};t.Rotation.W=1;t.Scale3D=FVector{1,1,1};t.Translation=c->K2_GetActorLocation();auto* spawned=UGameplayStatics::BeginDeferredActorSpawnFromClass(world,hud->LobbyWeaponDisplay->GetClass(),t,ESpawnActorCollisionHandlingMethod::AlwaysSpawn,nullptr);if(spawned)spawned=UGameplayStatics::FinishSpawningActor(spawned,t);if(!spawned||!spawned->IsA(ATslWeaponDisplay::StaticClass())){out<<"MULTI SPAWN FAILED "<<i<<std::endl;s.issued=true;continue;}s.display=static_cast<ATslWeaponDisplay*>(spawned);s.owner=c;s.ownerMesh=c->Mesh;auto* objlist=UObject::GObjects.GetTypedPtr();if(objlist)for(int oi=0;oi<objlist->Num();++oi)if(objlist->GetByIndex(oi)==s.display){s.objectIndex=oi;break;}auto baseW=Wide(base+"_C"),skinW=Wide(asset->second);s.display->SpawnWeapon(c,FString(baseW.c_str()),FString(L""),FString(skinW.c_str()),false);s.issued=true;out<<"MULTI SPAWN "<<i<<" "<<s.id<<" "<<s.skin<<std::endl;continue;} if(!s.attached&&s.display&&s.display->SpawnedWeapon){auto* weapon=s.display->SpawnedWeapon;auto* mesh=weapon->GetWeaponMeshComponent();if(!mesh)continue;auto current=mesh->ReplicatedSkinParam.SkinParam.SkinName.ToString();if(current!=s.skin){weapon->SetActorHiddenInGame(true);continue;}const wchar_t* name=i==0?L"MeshSlot_Secondary":i==1?L"MeshSlot_Sidearm":L"MeshSlot_Melee";auto socket=UKismetStringLibrary::Conv_StringToName(FString(name));if(!c->Mesh->DoesSocketExist(socket)){out<<"MULTI NO SOCKET "<<i<<std::endl;continue;}s.display->SetActorTickEnabled(false);weapon->SetActorScale3D(FVector{1,1,1});weapon->K2_AttachToComponent(c->Mesh,socket,EAttachmentRule::SnapToTarget,EAttachmentRule::SnapToTarget,EAttachmentRule::SnapToTarget,false);
 if(i==0||i==2){auto r=c->K2_GetActorRotation();auto right=UKismetMathLibrary::GetRightVector(r);FVector delta{};if(i==0){FVector center{},extent{};float radius=0;UKismetSystemLibrary::GetComponentBounds(mesh,&center,&extent,&radius);auto spine=UKismetStringLibrary::Conv_StringToName(FString(L"spine_02"));auto target=c->Mesh->GetSocketLocation(spine);delta=FVector{target.X-right.X*24.f-center.X,target.Y-right.Y*24.f-center.Y,target.Z-right.Z*24.f+12.f-center.Z};out<<"MULTI CENTER radius="<<radius<<std::endl;}else delta=FVector{-right.X*12.f,-right.Y*12.f,-right.Z*12.f};auto transform=c->Mesh->GetSocketTransform(socket,ERelativeTransformSpace::RTS_World);auto offset=UKismetMathLibrary::InverseTransformDirection(transform,delta);FHitResult hit{};weapon->K2_SetActorRelativeLocation(offset,false,&hit,true);out<<"MULTI OFFSET "<<i<<" "<<offset.X<<","<<offset.Y<<","<<offset.Z<<std::endl;}
 weapon->SetActorHiddenInGame(false);mesh->SetHiddenInGame(false,true);mesh->SetVisibility(true,true);s.attached=true;out<<"MULTI ATTACHED "<<i<<" "<<s.id<<" socket="<<socket.ToString()<<std::endl;}}
}
